PROGRAM main
  VAR
    Bottle_At_Gate : BOOL AT %MX0.0 := FALSE; (* Sensor: bottle waiting at the infeed gate (end of C3), used for the Starved filter *)
    Bottle_Counted : BOOL AT %MX0.1 := FALSE; (* Sensor: count sensor behind the gate, one pulse per bottle (Group_Counter counts the rising edge) *)
    Pusher_Home : BOOL AT %MX0.2 := FALSE; (* Sensor: group pusher retracted (home), the gate only opens with the pusher home *)
    Pusher_Out : BOOL AT %MX0.3 := FALSE; (* Sensor: group pusher fully out, the group is on the wrap conveyor (ends PUSH) *)
    Pack_At_Film : BOOL AT %MX0.4 := FALSE; (* Sensor: pack at the stop point right before the film slot *)
    Film_In_Slot : BOOL AT %MX0.5 := FALSE; (* Sensor: film sheet sticks out of the slot (slot empty before a feed, sheet there before the pack drives on) *)
    Film_Pulse : BOOL AT %MX0.6 := FALSE; (* Sensor: encoder on the film feed roller, one pulse per FilmPulseMM of film *)
    Wrap_Home : BOOL AT %MX0.7 := FALSE; (* Sensor: wrap bar at its home position, one wrap = leave home and come back *)
    Film_Empty : BOOL AT %MX4.0 := FALSE; (* Sensor: film roll empty, no new sheet is started *)
    Film_Low : BOOL AT %MX4.1 := FALSE; (* Sensor: film roll low, prepare the next roll (warning in FUXA only) *)
    Oven_Entry : BOOL AT %MX4.2 := FALSE; (* Sensor: pack at the oven entry (pulse per pack), Oven_Counter counts up *)
    Oven_Exit : BOOL AT %MX4.3 := FALSE; (* Sensor: pack at the oven exit (pulse per pack), Oven_Counter counts down, PackCount up *)
    Table_Full : BOOL AT %MX4.4 := FALSE; (* Sensor: outfeed table full (raw, filtered into Outfeed_Full) *)
    Airflow_OK : BOOL AT %MX4.5 := FALSE; (* Sensor: air flow switch in the oven duct, the blower really blows (heater interlock) *)
    OvenTemp : INT AT %MW12 := 0; (* Analog sensor: air temperature in the oven, 0.1 degC (1900 = 190.0 degC) *)
    E_Stop_OK : BOOL AT %MX1.1 := FALSE; (* Interface: E-stop chain healthy (FALSE = stop everything at once) *)
    Heartbeat : BOOL AT %MX1.2 := FALSE; (* Interface: toggled every 1 s by the simulator, watched by the heartbeat watchdog *)
    Cmd : INT AT %MW0 := 0; (* HMI command: 1 Start, 2 Stop, 3 Reset, 4 Reset counter (PLC sets it back to 0 after reading) *)
    ModeReq : INT AT %MW1 := 0; (* HMI mode: 0 Stop, 1 Auto, 2 Manual *)
    OvenSetpoint : INT AT %MW30 := 1900; (* HMI setpoint: oven air temperature, 0.1 degC *)
    OvenHyst : INT AT %MW31 := 50; (* HMI setpoint: heater hysteresis band, 0.1 degC *)
    OvenBand : INT AT %MW32 := 150; (* HMI setpoint: Oven_Ready window +- around OvenSetpoint, 0.1 degC (wider than OvenHyst) *)
    FilmLength : INT AT %MW33 := 850; (* HMI setpoint: length of one film sheet, mm (recipe value, limited to FilmMin..FilmMax) *)
    Man_C3 : BOOL AT %MX2.0 := FALSE; (* HMI manual button (hold-to-run): ConveyorMotor3 *)
    Man_Gate : BOOL AT %MX2.1 := FALSE; (* HMI manual button (hold-to-run): GateMotor *)
    Man_GroupPush : BOOL AT %MX2.2 := FALSE; (* HMI manual button (hold-to-run): GroupPusher *)
    Man_WrapConveyor : BOOL AT %MX2.3 := FALSE; (* HMI manual button (hold-to-run): WrapConveyor *)
    Man_FilmFeed : BOOL AT %MX2.4 := FALSE; (* HMI manual button (hold-to-run): FilmFeed *)
    Man_Knife : BOOL AT %MX2.5 := FALSE; (* HMI manual button (hold-to-run): Knife *)
    Man_WrapBar : BOOL AT %MX2.6 := FALSE; (* HMI manual button (hold-to-run): WrapBar *)
    Man_OvenConveyor : BOOL AT %MX2.7 := FALSE; (* HMI manual button (hold-to-run): OvenConveyor *)
    ConveyorMotor3 : BOOL AT %QX0.0 := FALSE; (* Output: C3 infeed conveyor, runs continuously, bottles queue at the closed gate *)
    GateMotor : BOOL AT %QX0.1 := FALSE; (* Output: infeed gate open, held while the group is not complete *)
    GroupPusher : BOOL AT %QX0.2 := FALSE; (* Output: pushes the complete group onto the wrap conveyor (spring return when OFF) *)
    WrapConveyor : BOOL AT %QX0.3 := FALSE; (* Output: conveyor from the collation table over the film slot to the oven *)
    FilmFeed : BOOL AT %QX0.4 := FALSE; (* Output: feed rollers, push film up through the slot until FeedPulses are counted *)
    Knife : BOOL AT %QX0.5 := FALSE; (* Output: cuts the sheet off the roll, ON for the whole CUT step (CutTime) *)
    WrapBar : BOOL AT %QX0.6 := FALSE; (* Output: wrap bar motor, one turn per pack lays the sheet over the top *)
    OvenHeater : BOOL AT %QX0.7 := FALSE; (* Output: oven heater (hysteresis), only in Auto and only with Airflow_OK *)
    OvenBlower : BOOL AT %QX1.0 := FALSE; (* Output: oven blower, runs with the oven on and BlowerRunOn after it (TOF) *)
    OvenConveyor : BOOL AT %QX1.1 := FALSE; (* Output: conveyor through the oven, runs while Oven_On or packs are inside *)
    State : INT AT %MW50 := 0; (* Status for the HMI: 0 Stopped, 1 Running, 2 Starved, 3 Blocked, 9 Fault (from both sequencers) *)
    Step : INT AT %MW51 := 0; (* Collation sequencer: 0 IDLE, 5 WARM_UP, 10 COUNT, 15 WAIT_WRAP, 20 PUSH, 25 RETRACT, 900 FAULT *)
    WrapStep : INT AT %MW52 := 0; (* Wrap sequencer: 0 IDLE, 10 WAIT_PACK, 20 FEED, 22 CUT, 24 READY, 30 RUN_ON, 32 WRAP, 34 RUN_OUT, 900 FAULT *)
    PackCount : INT AT %MW53 := 0; (* Status for the HMI: finished packs leaving the oven (Oven_Exit), zeroed by Cmd = 4 *)
    Alm_FilmFault : BOOL AT %MX5.0 := FALSE; (* Alarm (latched): FilmLength not counted in FeedTimeout, or no sheet in READY for SheetCheck -> FAULT *)
    Alm_PackJam : BOOL AT %MX5.1 := FALSE; (* Alarm (latched): PUSH / RETRACT / RUN_ON / RUN_OUT not finished within PushTimeout -> FAULT *)
    Alm_OutfeedBlocked : BOOL AT %MX5.2 := FALSE; (* Warning: Blocked longer than BlockedWarn, no FAULT *)
    Alm_CommLost : BOOL AT %MX5.3 := FALSE; (* Alarm (latched): heartbeat not toggled for 3 s, switches Master_Enable off (same bit in every PLC) *)
    Alm_FilmEmpty : BOOL AT %MX5.4 := FALSE; (* Warning (not latched): film roll empty and a pack waits for a sheet, State Starved *)
    Alm_OvenOverTemp : BOOL AT %MX5.5 := FALSE; (* Alarm (latched): OvenTemp >= OvenMax in every mode -> FAULT, heater off, blower on its run-on *)
    Alm_OvenHeatTimeout : BOOL AT %MX5.6 := FALSE; (* Alarm (latched): Oven_Ready not reached within HeatTimeout in WARM_UP -> FAULT *)
    Alm_OvenJam : BOOL AT %MX5.7 := FALSE; (* Alarm (latched): packs in the oven and no Oven_Exit for OvenJamTime -> FAULT *)
    Alm_AirflowLost : BOOL AT %MX7.0 := FALSE; (* Alarm (latched): blower on and no Airflow_OK within AirflowTimeout -> FAULT *)
    Alm_WrapTimeout : BOOL AT %MX7.1 := FALSE; (* Alarm (latched): WRAP, wrap bar not back at Wrap_Home within WrapTimeout -> FAULT *)
    Outfeed_Full : BOOL AT %MX3.0 := FALSE; (* Conditioned: Table_Full ON 2 s without a break, released after OFF 3 s *)
    Group_Complete : BOOL AT %MX3.1 := FALSE; (* Conditioned: Group_Counter reached PackSize, the gate closes *)
    Jog_Block : BOOL AT %MX3.2 := FALSE; (* Jog watchdog: a manual button held > 10 s, manual outputs ignored until all Man_* are released *)
    Heat_Demand : BOOL AT %MX3.3 := FALSE; (* Hysteresis latch: set at OvenTemp < OvenSetpoint - OvenHyst, reset at >= OvenSetpoint *)
    Oven_Ready : BOOL AT %MX3.4 := FALSE; (* Window compare: OvenTemp within OvenSetpoint +- OvenBand *)
    Starved : BOOL AT %MX3.5 := FALSE; (* Wrap waits for a pack and (no bottle at the gate for StarvedDelay, or film empty) -> State 2 *)
    Wrap_Clear : BOOL AT %MX3.6 := FALSE; (* Conditioned: wrap conveyor ran empty for ClearTime, the next group may be pushed *)
    Oven_On : BOOL AT %MX3.7 := FALSE; (* Conditioned: Master_Enable AND Auto AND no FAULT, drives heater, blower and oven conveyor *)
    GroupCount : INT AT %MW40 := 0; (* Computed for the HMI: bottles in the current group, 0-6 (Group_Counter.CV) *)
    PacksInOven : INT AT %MW41 := 0; (* Computed: packs inside the oven (Oven_Counter.CV, CTUD) *)
    FeedPulses : INT AT %MW42 := 0; (* Computed: pulses for one sheet, LIMIT(FilmMin, FilmLength, FilmMax) / FilmPulseMM *)
    FeedCount : INT AT %MW43 := 0; (* Computed: pulses fed for the current sheet (Feed_Counter.CV), kept through Stop and E-stop *)
    PackSize : INT := 6; (* Constant: bottles per pack, PV of Group_Counter *)
    FilmPulseMM : INT := 50; (* Constant: film per Film_Pulse, mm *)
    FilmMin : INT := 600; (* Constant: shortest sheet, mm (lower limit of FilmLength before the DIV) *)
    FilmMax : INT := 1200; (* Constant: longest sheet, mm (upper limit of FilmLength before the DIV) *)
    OvenMax : INT := 2300; (* Constant: oven over-temperature limit, 0.1 degC (230.0 degC) *)
    StarvedDelay : TIME := T#2s; (* Constant: no bottle at the gate this long = Starved *)
    ClearTime : TIME := T#3s; (* Constant: the wrap conveyor must run empty this long before the next push *)
    PushTimeout : TIME := T#3s; (* Constant: PUSH, RETRACT, RUN_ON and RUN_OUT must finish within this time *)
    FeedTimeout : TIME := T#10s; (* Constant: FEED must count FeedPulses within this time *)
    CutTime : TIME := T#300ms; (* Constant: length of CUT (knife ON) *)
    SheetCheck : TIME := T#1s; (* Constant: READY without Film_In_Slot this long = sheet missing *)
    WrapTimeout : TIME := T#5s; (* Constant: WRAP must see the wrap bar back home within this time *)
    HeatTimeout : TIME := T#120s; (* Constant: WARM_UP must reach Oven_Ready within this time (simulator time) *)
    BlowerRunOn : TIME := T#30s; (* Constant: TOF, the blower keeps running this long after the oven is switched off *)
    AirflowTimeout : TIME := T#3s; (* Constant: blower on and no Airflow_OK this long = Alm_AirflowLost *)
    OvenJamTime : TIME := T#20s; (* Constant: packs inside and no pack out this long = Alm_OvenJam *)
    BlockedWarn : TIME := T#2m; (* Constant: Blocked this long -> Alm_OutfeedBlocked (same as the filler and the labeler) *)
    Def_OvenSetpoint : INT := 1900; (* Default for OvenSetpoint, written once at the first scan *)
    Def_OvenHyst : INT := 50; (* Default for OvenHyst, written once at the first scan *)
    Def_OvenBand : INT := 150; (* Default for OvenBand, written once at the first scan *)
    Def_FilmLength : INT := 850; (* Default for FilmLength, written once at the first scan *)
    Init_Done : BOOL := FALSE; (* First-scan flag: setpoint defaults already written *)
    Mode_Stop : BOOL := FALSE; (* Decoded ModeReq = 0 (Stop mode; the logic itself uses NOT Mode_Auto / NOT Mode_Manual) *)
    Mode_Auto : BOOL := FALSE; (* Decoded ModeReq = 1: the sequencers control the machine *)
    Mode_Manual : BOOL := FALSE; (* Decoded ModeReq = 2: the operator jogs single actuators *)
    Start_Cmd : BOOL := FALSE; (* Decoded Cmd = 1, TRUE for one scan *)
    Stop_Cmd : BOOL := FALSE; (* Decoded Cmd = 2, TRUE for one scan *)
    Reset_Cmd : BOOL := FALSE; (* Decoded Cmd = 3, TRUE for one scan *)
    Count_Reset_Cmd : BOOL := FALSE; (* Decoded Cmd = 4, TRUE for one scan: zero PackCount (separate from Reset) *)
    Master_Enable : BOOL := FALSE; (* MCR equivalent: E_Stop_OK AND NOT Alm_CommLost, gates every output FB *)
    Hb_Last : BOOL := FALSE; (* Heartbeat value of the previous scan *)
    Hb_Changed : BOOL := FALSE; (* Heartbeat changed in this scan (Heartbeat XOR Hb_Last) *)
    Hb_Timer : TON; (* Heartbeat watchdog: 3 s without a change -> Alm_CommLost *)
    Oven_Low_Lim : INT := 0; (* OvenSetpoint - OvenBand: lower edge of the Oven_Ready window, 0.1 degC *)
    Oven_High_Lim : INT := 0; (* OvenSetpoint + OvenBand: upper edge of the Oven_Ready window, 0.1 degC *)
    Heat_On_Lim : INT := 0; (* OvenSetpoint - OvenHyst: Heat_Demand set threshold, 0.1 degC *)
    Oven_AboveLow : BOOL := FALSE; (* OvenTemp >= Oven_Low_Lim (window lower edge, Oven_Ready) *)
    Oven_BelowHigh : BOOL := FALSE; (* OvenTemp <= Oven_High_Lim (window upper edge, Oven_Ready) *)
    Oven_Cold : BOOL := FALSE; (* OvenTemp < Heat_On_Lim (Heat_Demand set condition) *)
    Oven_BelowSet : BOOL := FALSE; (* OvenTemp < OvenSetpoint (Heat_Demand hold condition) *)
    Oven_BelowMax : BOOL := FALSE; (* OvenTemp < OvenMax (heater interlock, over-temperature alarm) *)
    Film_Len_Used : INT := 0; (* FilmLength limited to FilmMin..FilmMax (LIMIT), input of the DIV -> FeedPulses *)
    Full_OnTimer : TON; (* Outfeed_Full filter: Table_Full ON for 2 s without a break *)
    Full_OffTimer : TON; (* Outfeed_Full filter: Table_Full OFF for 3 s *)
    Gate_Empty_Timer : TON; (* Starved filter: no bottle at the gate for StarvedDelay *)
    Wrap_Edge : BOOL := FALSE; (* Rising edge of Wrap_Home: TRUE for one scan when the wrap bar arrives home *)
    Exit_Edge : BOOL := FALSE; (* Rising edge of Oven_Exit: TRUE for one scan per pack out of the oven *)
  END_VAR

