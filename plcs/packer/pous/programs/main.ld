    {
      "id": "rung_main_93e7ed73-6bfd-4155-9ec1-a3ed60783ba9",
      "comment": "Oven compares: Oven_AboveLow / Oven_BelowHigh = window edges (inclusive), Oven_Cold = set and Oven_BelowSet = hold condition of Heat_Demand. Compare blocks write OUT into a BOOL: ENO only copies EN, it is not the result.",
      "defaultBounds": [
        300,
        100
      ],
      "reactFlowViewport": [
        1486,
        174
      ],
