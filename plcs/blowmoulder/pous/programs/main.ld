      "id": "rung_main_22fb50e5-8d5b-4b3a-9d92-38dd799ee0d5",
      "comment": "First scan 1/2: write the BlowSetpoint default once (the fifth setpoint does not fit the MOVE chain of the next rung). Must stay above First scan 2/2, which sets Init_Done",
      "defaultBounds": [
        300,
        100
      ],
      "reactFlowViewport": [
        598,
        134
      ],
      "nodes": [
        {
          "id": "left-rail-rung_main_22fb50e5-8d5b-4b3a-9d92-38dd799ee0d5",
          "type": "powerRail",
          "position": {
            "x": 0,
