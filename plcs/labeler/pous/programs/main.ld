PROGRAM main
  VAR
    Bottle_At_Gate : BOOL AT %MX0.0 := FALSE; (* Sensor: bottle waiting at the infeed gate (end of C2) *)
    Bottle_In_Pocket : BOOL AT %MX0.1 := FALSE; (* Sensor: bottle in the station pocket on the turntable *)
    Bell_Down : BOOL AT %MX0.2 := FALSE; (* Sensor: centering bell down, bottle clamped (bell up = NOT Bell_Down) *)
    Label_Present : BOOL AT %MX0.3 := FALSE; (* Sensor: label on the bottle in the pocket (used on a restart only) *)
    C3_Full : BOOL AT %MX0.4 := FALSE; (* Sensor: C3 outfeed conveyor to the packer full (raw, filtered into Outfeed_Full) *)
    Roll_Empty : BOOL AT %MX0.5 := FALSE; (* Sensor: label roll empty, end of the web (Alm_LabelEmpty, State Starved) *)
    Label_Mark : BOOL AT %MX0.6 := FALSE; (* Sensor: registration mark on the label web, one label length fed -> cut *)
    Spin_Pulse : BOOL AT %MX0.7 := FALSE; (* Sensor: one pulse per turn of the turntable (cam), counted by Spin_Counter *)
    Roll_Low : BOOL AT %MX4.0 := FALSE; (* Sensor: label roll low, prepare the next roll (warning in FUXA only) *)
    Glue_Low : BOOL AT %MX4.1 := FALSE; (* Sensor: glue level low in the melt tank, add glue blocks (warning in FUXA only) *)
    GlueTemp : INT AT %MW12 := 0; (* Analog sensor: hot-melt temperature in the melt tank, 0.1 degC (1700 = 170.0 degC) *)
    E_Stop_OK : BOOL AT %MX1.1 := FALSE; (* Interface: E-stop chain healthy (FALSE = stop everything at once) *)
    Heartbeat : BOOL AT %MX1.2 := FALSE; (* Interface: toggled every 1 s by the simulator, watched by the heartbeat watchdog *)
    Cmd : INT AT %MW0 := 0; (* HMI command: 1 Start, 2 Stop, 3 Reset, 4 Reset counter (PLC sets it back to 0 after reading) *)
    ModeReq : INT AT %MW1 := 0; (* HMI mode: 0 Stop, 1 Auto, 2 Manual *)
    GlueSetpoint : INT AT %MW30 := 1700; (* HMI setpoint: melt temperature, 0.1 degC *)
    GlueHyst : INT AT %MW31 := 50; (* HMI setpoint: heater hysteresis band, 0.1 degC *)
    GlueBand : INT AT %MW32 := 100; (* HMI setpoint: Glue_Ready window +- around GlueSetpoint, 0.1 degC (wider than GlueHyst) *)
    PressTurns : INT AT %MW33 := 2; (* HMI setpoint: bottle turns after the cut (label tail pressed on) *)
    Man_C2 : BOOL AT %MX2.0 := FALSE; (* HMI manual button (hold-to-run): ConveyorMotor2 *)
    Man_Gate : BOOL AT %MX2.1 := FALSE; (* HMI manual button (hold-to-run): GateMotor *)
    Man_Clamp : BOOL AT %MX2.2 := FALSE; (* HMI manual button (hold-to-run): ClampValve *)
    Man_Spin : BOOL AT %MX2.3 := FALSE; (* HMI manual button (hold-to-run): SpinMotor, only with the bell down (interlock) *)
    Man_Feed : BOOL AT %MX2.4 := FALSE; (* HMI manual button (hold-to-run): LabelFeed + GlueRoller together *)
    Man_Cut : BOOL AT %MX2.5 := FALSE; (* HMI manual button (hold-to-run): Cutter *)
    Man_Discharge : BOOL AT %MX2.6 := FALSE; (* HMI manual button (hold-to-run): DischargeMotor *)
    ConveyorMotor2 : BOOL AT %QX0.0 := FALSE; (* Output: C2 infeed conveyor, runs continuously, bottles queue at the gate *)
    GateMotor : BOOL AT %QX0.1 := FALSE; (* Output: opens the infeed gate (TP pulse, admits one bottle) *)
    ClampValve : BOOL AT %QX0.2 := FALSE; (* Output: centering bell down (pneumatic), holds the bottle *)
    SpinMotor : BOOL AT %QX0.3 := FALSE; (* Output: turntable, spins the bottle so the label wraps around it *)
    LabelFeed : BOOL AT %QX0.4 := FALSE; (* Output: feed rollers, pull the label web off the roll *)
    Cutter : BOOL AT %QX0.5 := FALSE; (* Output: knife, cuts one label off the web (TP pulse) *)
    GlueRoller : BOOL AT %QX0.6 := FALSE; (* Output: glue roller, hot melt on the label edges *)
    GlueHeater : BOOL AT %QX0.7 := FALSE; (* Output: heater of the melt tank (hysteresis, every mode) *)
    DischargeMotor : BOOL AT %QX1.0 := FALSE; (* Output: pushes the labelled bottle out of the pocket onto C3 *)
    State : INT AT %MW50 := 0; (* Status for the HMI: 0 Stopped, 1 Running, 2 Starved, 3 Blocked, 9 Fault *)
    Step : INT AT %MW51 := 0; (* Sequencer step: 0 IDLE, 5 WARM_UP, 10 WAIT_BOTTLE, 20 CLAMP, 22 WRAP, 24 PRESS, 26 UNCLAMP, 35 WAIT_OUTFEED, 40 DISCHARGE, 900 FAULT *)
    GoodCount : INT AT %MW53 := 0; (* Status for the HMI: labelled bottles discharged onto C3, zeroed by Cmd = 4 *)
    Alm_LabelTimeout : BOOL AT %MX5.0 := FALSE; (* Alarm (latched): no Label_Mark in WRAP or PressTurns not reached in PRESS within LabelTimeout -> FAULT *)
    Alm_PocketJam : BOOL AT %MX5.1 := FALSE; (* Alarm (latched): bottle not in the pocket, CLAMP / UNCLAMP or DISCHARGE not finished in time -> FAULT *)
    Alm_OutfeedBlocked : BOOL AT %MX5.2 := FALSE; (* Warning: Blocked longer than BlockedWarn, no FAULT *)
    Alm_CommLost : BOOL AT %MX5.3 := FALSE; (* Alarm (latched): heartbeat not toggled for 3 s, switches Master_Enable off (same bit in every PLC) *)
    Alm_LabelEmpty : BOOL AT %MX5.4 := FALSE; (* Warning (not latched): label roll empty, no new bottle admitted, State Starved *)
    Alm_GlueOverTemp : BOOL AT %MX5.5 := FALSE; (* Alarm (latched): GlueTemp >= GlueMax -> FAULT, heater off *)
    Alm_GlueHeatTimeout : BOOL AT %MX5.6 := FALSE; (* Alarm (latched): Glue_Ready not reached within HeatTimeout in WARM_UP -> FAULT *)
    Outfeed_Full : BOOL AT %MX3.0 := FALSE; (* Conditioned: C3_Full ON 2 s without a break, released after OFF 3 s *)
    Bottle_Entering : BOOL AT %MX3.1 := FALSE; (* Conditioned: set by the gate pulse, reset by Bottle_In_Pocket; blocks a second gate pulse *)
    Jog_Block : BOOL AT %MX3.2 := FALSE; (* Jog watchdog: a manual button held > 10 s, manual outputs ignored until all Man_* are released *)
    Heat_Demand : BOOL AT %MX3.3 := FALSE; (* Hysteresis latch: set at GlueTemp < GlueSetpoint - GlueHyst, reset at >= GlueSetpoint *)
    Glue_Ready : BOOL AT %MX3.4 := FALSE; (* Window compare: GlueTemp within GlueSetpoint +- GlueBand *)
    Starved : BOOL AT %MX3.5 := FALSE; (* WAIT_BOTTLE and (no bottle at the gate for StarvedDelay, or Roll_Empty) -> State 2 *)
    GatePulse : TIME := T#500ms; (* Constant: TP length of the gate, admits one bottle *)
    CutPulse : TIME := T#200ms; (* Constant: TP length of the knife *)
    StarvedDelay : TIME := T#2s; (* Constant: no bottle at the gate this long = Starved *)
    ClampTimeout : TIME := T#2s; (* Constant: CLAMP / UNCLAMP and gate -> pocket must finish within this time *)
    LabelTimeout : TIME := T#5s; (* Constant: WRAP must see Label_Mark, PRESS must count PressTurns within this time *)
    OutTimeout : TIME := T#3s; (* Constant: DISCHARGE must empty the pocket within this time *)
    HeatTimeout : TIME := T#120s; (* Constant: WARM_UP must reach Glue_Ready within this time (simulator time) *)
    GlueMax : INT := 2000; (* Constant: glue over-temperature limit, 0.1 degC (200.0 degC) *)
    BlockedWarn : TIME := T#2m; (* Constant: Blocked this long -> Alm_OutfeedBlocked (same as the filler) *)
    Def_GlueSetpoint : INT := 1700; (* Default for GlueSetpoint, written once at the first scan *)
    Def_GlueHyst : INT := 50; (* Default for GlueHyst, written once at the first scan *)
    Def_GlueBand : INT := 100; (* Default for GlueBand, written once at the first scan *)
    Def_PressTurns : INT := 2; (* Default for PressTurns, written once at the first scan *)
    Init_Done : BOOL := FALSE; (* First-scan flag: setpoint defaults already written *)
    Mode_Stop : BOOL := FALSE; (* Decoded ModeReq = 0 (Stop mode; the logic itself uses NOT Mode_Auto / NOT Mode_Manual) *)
    Mode_Auto : BOOL := FALSE; (* Decoded ModeReq = 1: the sequencer controls the machine *)
    Mode_Manual : BOOL := FALSE; (* Decoded ModeReq = 2: the operator jogs single actuators *)
    Start_Cmd : BOOL := FALSE; (* Decoded Cmd = 1, TRUE for one scan *)
    Stop_Cmd : BOOL := FALSE; (* Decoded Cmd = 2, TRUE for one scan *)
    Reset_Cmd : BOOL := FALSE; (* Decoded Cmd = 3, TRUE for one scan *)
    Count_Reset_Cmd : BOOL := FALSE; (* Decoded Cmd = 4, TRUE for one scan: zero GoodCount (separate from Reset) *)
    Master_Enable : BOOL := FALSE; (* MCR equivalent: E_Stop_OK AND NOT Alm_CommLost, gates every output FB *)
    Hb_Last : BOOL := FALSE; (* Heartbeat value of the previous scan *)
    Hb_Changed : BOOL := FALSE; (* Heartbeat changed in this scan (Heartbeat XOR Hb_Last) *)
    Hb_Timer : TON; (* Heartbeat watchdog: 3 s without a change -> Alm_CommLost *)
    Glue_Low_Lim : INT := 0; (* GlueSetpoint - GlueBand: lower edge of the Glue_Ready window, 0.1 degC *)
    Glue_High_Lim : INT := 0; (* GlueSetpoint + GlueBand: upper edge of the Glue_Ready window, 0.1 degC *)
    Heat_On_Lim : INT := 0; (* GlueSetpoint - GlueHyst: Heat_Demand set threshold, 0.1 degC *)
    Glue_AboveLow : BOOL := FALSE; (* GlueTemp >= Glue_Low_Lim (window lower edge, Glue_Ready) *)
    Glue_BelowHigh : BOOL := FALSE; (* GlueTemp <= Glue_High_Lim (window upper edge, Glue_Ready) *)
    Glue_Cold : BOOL := FALSE; (* GlueTemp < Heat_On_Lim (Heat_Demand set condition) *)
    Glue_BelowSet : BOOL := FALSE; (* GlueTemp < GlueSetpoint (Heat_Demand hold condition) *)
    Full_OnTimer : TON;
    Full_OffTimer : TON;
    Gate_Empty_Timer : TON;
    Mark_Edge : BOOL := FALSE;
  END_VAR

