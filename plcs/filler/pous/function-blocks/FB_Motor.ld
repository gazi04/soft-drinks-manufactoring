FUNCTION_BLOCK FB_Motor
  VAR
    Sec_Timer : TON; (* Internal 1-second timer *)
  END_VAR
  VAR_INPUT
    Run : BOOL; (* "I want the motor on" *)
    Enable : BOOL; (* "it's allowed" (Master_Enable *)
  END_VAR
  VAR_OUTPUT
    Out : BOOL;
    Starts : DINT;
    RunTime : DINT; (* Running time in secods *)
  END_VAR

